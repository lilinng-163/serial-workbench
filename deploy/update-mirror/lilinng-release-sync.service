# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Mirror the latest Serial Workbench GitHub release
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -n /srv/lilinng-web/release-sync.lock /usr/bin/python3 /srv/lilinng-web/sync_github_release.py
TimeoutStartSec=10min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/lilinng-web/www/shared/updates /srv/lilinng-web/release-sync.lock
